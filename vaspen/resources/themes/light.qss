/* VASPen light theme — Fusion style + palette (#f0f0f0 chrome).
 * Mirrors dark.qss selector-for-selector; keep the two files in
 * sync when editing (CLAUDE.md §7.9). No font rules, no scrollbar
 * rules (palette-driven). */

QMainWindow::separator {
    background: #c8c8c8;
    width: 2px;
    height: 2px;
}

QDockWidget {
    color: #1a1a1a;
}
QDockWidget::title {
    background: #e3e3e3;
    border: 1px solid #c8c8c8;
    padding: 5px 8px;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QMenuBar {
    background: #f0f0f0;
    border-bottom: 1px solid #d0d0d0;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}
QMenuBar::item:selected {
    background: #e0e8f0;
}

QMenu {
    background: #ffffff;
    border: 1px solid #c8c8c8;
}
QMenu::item {
    padding: 5px 28px 5px 24px; /* 24px left: checkable-item indicators */
}
QMenu::item:selected {
    background: #0078d4;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #8a8a8a;
}
QMenu::separator {
    height: 1px;
    background: #e0e0e0;
    margin: 4px 8px;
}

QToolBar {
    background: #f0f0f0;
    border-bottom: 1px solid #d0d0d0;
    padding: 2px;
}
QToolBar QToolButton {
    background: transparent;
    border: none;
    padding: 3px 6px;
}
QToolBar QToolButton:hover {
    background: #e0e0e0;
}
QToolBar QToolButton:pressed, QToolBar QToolButton:checked {
    background: #d0d0d0;
}

/* Instant-popup choosers (MenuButton + view-direction buttons). */
QToolButton[popupMode="1"] {
    background: #f0f0f0;
    border: 1px solid #b8b8b8;
    border-radius: 3px;
    padding: 2px 10px 2px 8px;
}
QToolButton[popupMode="1"]:pressed {
    background: #d0d0d0;
}

/* The edit-toolbar flow container: keep its buttons flat (the id
 * selector beats the popupMode attribute selector). */
QWidget#edit_toolbar QToolButton {
    background: transparent;
    border: none;
    padding: 3px 6px;
}
QWidget#edit_toolbar QToolButton:hover {
    background: #e0e0e0;
}
QWidget#edit_toolbar QToolButton:pressed, QWidget#edit_toolbar QToolButton:checked {
    background: #d0d0d0;
}

QStatusBar {
    background: #f0f0f0;
    border-top: 1px solid #d0d0d0;
}
QStatusBar::item {
    border: none;
}

QGroupBox {
    border: 1px solid #c8c8c8;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 4px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 3px;
}

QPushButton {
    background: #e8e8e8;
    border: 1px solid #b8b8b8;
    border-radius: 3px;
    padding: 4px 12px;
}
QPushButton:hover {
    background: #dedede;
}
QPushButton:pressed {
    background: #d0d0d0;
}
QPushButton:disabled {
    color: #8a8a8a;
}
QPushButton:default {
    border: 1px solid #0078d4; /* never widen — layout shift */
}

QLineEdit, QSpinBox, QDoubleSpinBox {
    background: #ffffff;
    border: 1px solid #b8b8b8;
    border-radius: 3px;
    padding: 3px 5px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #0078d4;
}

QTableWidget {
    background: #ffffff;
    gridline-color: #e0e0e0;
}
QTableWidget::item:selected {
    background: #cde4f7;
    color: #1a1a1a;
}
QHeaderView::section {
    background: #e8e8e8;
    border: none;
    border-bottom: 1px solid #c8c8c8;
    border-right: 1px solid #d8d8d8;
    padding: 4px 6px;
}

QTabWidget::pane {
    border: 1px solid #c8c8c8;
    top: -1px;
}
QTabBar::tab {
    background: #e8e8e8;
    border: 1px solid #c8c8c8;
    padding: 5px 14px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: #ffffff;
    border-bottom-color: #ffffff;
}

QListWidget::item:selected {
    background: #cde4f7;
    color: #1a1a1a;
}

QToolTip {
    background: #ffffff;
    color: #1a1a1a;
    border: 1px solid #808080;
}

/* Hint labels (hintKind property — replaces the old hardcoded colors). */
QLabel[hintKind="error"] {
    color: #b00020;
}
QLabel[hintKind="warn"] {
    color: #b06000;
}
